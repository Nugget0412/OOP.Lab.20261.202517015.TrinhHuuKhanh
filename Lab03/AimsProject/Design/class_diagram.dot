digraph AIMS {
  rankdir=BT; node [shape=record, fontname="Helvetica", fontsize=10]; edge [fontname="Helvetica", fontsize=9];
  Media [label="{«abstract»\nMedia|- id: int\l- title: String\l- category: String\l- cost: float\l- nbMedia: int \{static\}\l+ COMPARE_BY_TITLE_COST: Comparator \{static\}\l+ COMPARE_BY_COST_TITLE: Comparator \{static\}\l|+ getId(), getTitle(), getCategory(), getCost()\l+ setTitle(title: String)\l+ isMatch(title: String): boolean\l+ equals(o: Object): boolean\l+ toString(): String\l}"];
  Book [label="{Book|- authors: List\<String\>\l- content: String\l|+ addAuthor(name: String)\l+ removeAuthor(name: String)\l+ getContentLength(): int\l+ toString(): String\l}"];
  Disc [label="{Disc|- length: int\l- director: String\l|+ getLength(): int\l+ getDirector(): String\l}"];
  DVD [label="{DigitalVideoDisc||+ play()\l+ toString(): String\l}"];
  CD [label="{CompactDisc|- artist: String\l- tracks: ArrayList\<Track\>\l|+ getArtist(): String\l+ addTrack(t: Track)\l+ removeTrack(t: Track)\l+ getLength(): int\l+ play()\l+ toString(): String\l}"];
  Track [label="{Track|- title: String\l- length: int\l|+ getTitle(), getLength()\l+ play()\l+ equals(o: Object): boolean\l}"];
  Playable [label="{«interface»\nPlayable||+ play()\l}"];
  CmpTC [label="{MediaComparatorByTitleCost||+ compare(m1, m2): int\l}"];
  CmpCT [label="{MediaComparatorByCostTitle||+ compare(m1, m2): int\l}"];
  Comparator [label="{«interface»\nComparator\<Media\>||+ compare(m1, m2): int\l}"];
  Cart [label="{Cart|+ MAX_NUMBERS_ORDERED: int = 20\l- itemsOrdered: ArrayList\<Media\>\l|+ addMedia(m), removeMedia(m)\l+ totalCost(): float\l+ print()\l+ searchById(id: int)\l+ searchByTitle(title: String)\l+ sortByTitleCost(), sortByCostTitle()\l+ empty()\l}"];
  Store [label="{Store|- itemsInStore: ArrayList\<Media\>\l|+ addMedia(m), removeMedia(m)\l+ findByTitle(title): Media\l+ print()\l}"];
  Aims [label="{Aims||+ main(args: String[])\l+ showMenu(), storeMenu()\l+ mediaDetailsMenu(), cartMenu()\l}"];
  {Book Disc} -> Media [arrowhead=empty];
  {DVD CD} -> Disc [arrowhead=empty];
  {DVD CD Track} -> Playable [arrowhead=empty, style=dashed];
  {CmpTC CmpCT} -> Comparator [arrowhead=empty, style=dashed];
  CD -> Track [arrowtail=odiamond, dir=back, headlabel="0..*", taillabel="1"];
  Cart -> Media [arrowtail=odiamond, dir=back, headlabel="0..20"];
  Store -> Media [arrowtail=odiamond, dir=back, headlabel="0..*"];
  Media -> CmpTC [style=dashed, arrowhead=vee, label="uses"];
  Media -> CmpCT [style=dashed, arrowhead=vee, label="uses"];
  Aims -> Cart [arrowhead=vee]; Aims -> Store [arrowhead=vee];
}
