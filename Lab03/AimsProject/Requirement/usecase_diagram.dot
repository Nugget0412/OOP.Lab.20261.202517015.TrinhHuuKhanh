digraph UC {
  rankdir=LR; fontname="Helvetica"; node [fontname="Helvetica", fontsize=10]; edge [fontname="Helvetica", fontsize=8, arrowhead=none];
  Customer [shape=none, label="🧍\nCustomer"]; Manager [shape=none, label="🧍\nStore manager"];
  subgraph cluster_aims { label="AIMS"; style=rounded; node [shape=ellipse];
    view[label="View store"]; details[label="See media details"]; addc[label="Add media to cart"];
    play[label="Play media (CD / DVD)"]; cart[label="See current cart"]; filter[label="Filter cart\n(by ID / title)"];
    sort[label="Sort cart\n(by title / cost)"]; remc[label="Remove media from cart"]; order[label="Place order"];
    upd[label="Update store"]; adds[label="Add media to store"]; rems[label="Remove media from store"]; }
  Customer -> {view cart addc play order};
  Manager -> upd;
  edge [style=dashed, arrowhead=vee];
  details -> view [label="«extend»"]; filter -> cart [label="«extend»"]; sort -> cart [label="«extend»"]; remc -> cart [label="«extend»"];
  adds -> upd [label="«extend»"]; rems -> upd [label="«extend»"];
}
